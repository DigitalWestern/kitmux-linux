 bool kitty_render_set_font_size(kitty_engine *e, double font_size_points,
                                 int *cell_width_px, int *cell_height_px,
                                 char *errbuf, size_t errbuf_len);
+// Replace shared font data at a new backing scale while preserving the
+// configured point size and all live sessions. Requires the host GL context.
+// Reports the new backing-pixel cell size.
+bool kitty_render_set_scale(kitty_engine *e, double scale,
+                            int *cell_width_px, int *cell_height_px,
+                            char *errbuf, size_t errbuf_len);
+// Current renderer backing scale, or 0 before render initialization.
+double kitty_render_scale(kitty_engine *e);

 // Per-view sizing: call after render init and again on every view resize,
 // GL context current. Sizes the render viewport AND resizes the terminal
diff --git a/libkitty/py/glue.py b/libkitty/py/glue.py
index 4c94404..e35d8a1 100644
--- a/libkitty/py/glue.py
+++ b/libkitty/py/glue.py
@@ -1048,21 +1048,29 @@ def render_init(scale):
     return opts.font_size, cw, ch


-def render_set_font_size(size):
+def _replace_fonts(size, scale):
     from kitty import fast_data_types as fdt
     # load_fonts_data may trim/move the previous font group. Drop every stub
     # that points into that group before asking kitty for its replacement.
     sessions = tuple(_sessions)
     for session in sessions:
         session.stub = None
-    dpi = 96.0 * _render['scale']
+    dpi = 96.0 * scale
     cap, cw, ch = fdt.libkitty_create_fonts_data(size, dpi, dpi)
-    _render.update(cap=cap, size=size, cw=cw, ch=ch)
+    _render.update(cap=cap, size=size, scale=scale, cw=cw, ch=ch)
     for session in sessions:
         fdt.libkitty_set_screen_cell_size(session.screen, cw, ch)
     return cw, ch


+def render_set_font_size(size):
+    return _replace_fonts(size, _render['scale'])
+
+
+def render_set_scale(scale):
+    return _replace_fonts(_render['size'], scale)
+
+
 def set_viewport(session, fb_w, fb_h):
     # v0 behavior: the session fills the whole framebuffer.
     set_geometry(session, fb_w, fb_h, 0, 0, fb_w, fb_h)
