     } else if (!r) {
         lk_format_py_error(errbuf, errbuf_len);
@@ -42,6 +45,11 @@ kitty_render_font_size(kitty_engine *e) {
     return e && e->render_ready ? e->font_size : 0.0;
 }

+double
+kitty_render_scale(kitty_engine *e) {
